          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "flutter-shopsync-app",
          "appId": "1:108126633602:ios:40055fe2f76bd483527e9b",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "flutter-shopsync-app",
          "configurations": {
            "android": "1:108126633602:android:a56e7c9adad36977527e9b",
            "ios": "1:108126633602:ios:40055fe2f76bd483527e9b",
